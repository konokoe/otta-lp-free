---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import FV from '../components/FV.astro';
import Concerns from '../components/Concerns.astro';
import Product from '../components/Product.astro';
import Network from '../components/Network.astro';
import Points from '../components/Points.astro';
import Pricing from '../components/Pricing.astro';
import CtaMid from '../components/CtaMid.astro';
import Flow from '../components/Flow.astro';
import Voices from '../components/Voices.astro';
import AppFeatures from '../components/AppFeatures.astro';
import CtaFirst from '../components/CtaFirst.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="高齢者の見守りサービス｜認知症の外出・ひとり歩き対策｜otta" description="認知症のある高齢者や離れて暮らす親の外出を見守るotta。8gの軽い端末を持ち歩くだけで、街中の見守りスポットが位置情報を自動で記録。充電不要・操作不要で利用できます。">
  <Header />
  <main>
    <FV />
    <Concerns />
    <Product />
    <Network />
    <Points />
    <Pricing />
    <CtaMid />
    <Flow />
    <Voices />
    <AppFeatures />
    <CtaFirst />
    <FAQ />
  </main>
  <Footer />
</BaseLayout>
