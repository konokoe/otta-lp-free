---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import FV from '../components/FV.astro';
import PlanDiff from '../components/PlanDiff.astro';
import Product from '../components/Product.astro';
import Network from '../components/Network.astro';
import Points from '../components/Points.astro';
import Pricing from '../components/Pricing.astro';
import CtaMid from '../components/CtaMid.astro';
import Flow from '../components/Flow.astro';
import Voices from '../components/Voices.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="月額0円から始める高齢者見守りサービス｜otta" description="離れて暮らす親をそっと見守る、高齢者向け見守りサービス「otta」。月額0円のプランから始められます。お守り型の端末を持ち歩くだけで、街中の見守りスポットが位置情報を自動で記録。充電不要・操作不要で、スマホも必要ありません。">
  <Header />
  <main>
    <FV />
    <PlanDiff />
    <Points />
    <Network />
    <CtaMid />
    <Flow />
    <Pricing />
    <Product />
    <Voices />
    <FAQ />
  </main>
  <Footer />
</BaseLayout>
