---
import { Image } from 'astro:assets';
import CampaignBanner from './ui/CampaignBanner.astro';
import img01 from '../assets/fv-images-01.jpg';
import img02 from '../assets/fv-images-02.jpg';
import img03 from '../assets/fv-images-03.jpg';
import detailImg from '../assets/fv-detail-01.png';
import cDetailImg from '../assets/c-detail-01.png';

const slides = [
  { id: 1, photo: img01, benefit2Label: 'プレミアムプラン' },
  { id: 2, photo: img02, benefit2Label: 'プレミアムプラン' },
  { id: 3, photo: img03, benefit2Label: 'プレミアムプラン' },
];
---

<section class="fv">
  <!-- スライダー + コピーエリアのラッパー -->
  <div class="fv__stage">
    <!-- Swiper（写真のみ） -->
    <div class="fv__swiper-wrap">
    <div class="swiper fv-swiper">
      <div class="swiper-wrapper">
        {slides.map(slide => (
          <div class="swiper-slide fv-slide">
            <Image src={slide.photo} alt="" class="fv-card__photo" format="avif" />
          </div>
        ))}
      </div>
    </div>
    </div>

    <!-- キャッチコピー（通常フロー） -->
    <div class="fv__copy">
      <h1 class="fv__title">
        お出かけ先まで<br class="br-sp" />見守りが<br class="br-pc" />届いて<br class="br-sp" />はじめて安心に
      </h1>
    </div>

    <!-- 端末画像（position で重ねる） -->
    <div class="fv__detail">
      <Image src={cDetailImg} alt="otta 端末" class="fv__detail-device" format="avif" />
      <Image src={detailImg} alt="otta アプリ画面" class="fv__detail-img" format="avif" />
    </div>
  </div>

  <!-- キャンペーンバナー（スライドに連動して benefit2Label が変わる） -->
  <div class="fv__banners">
    {slides.map((slide, i) => (
      <div class:list={['fv__banner', i === 0 && 'is-active']} data-index={i}>
        <CampaignBanner benefit2Label={slide.benefit2Label} location="fv" />
      </div>
    ))}
  </div>
</section>

<style>
  .fv {
    padding-top: clamp(6rem, 14vw, 7rem);
    background-color: var(--c-g-100);
  }

  @media (min-width: 1400px) {
    .fv {
      padding-top: 4rem;
    }
  }

  /* ステージ（スワイパー＋オーバーレイの基準） */
  .fv__stage {
    position: relative;
  }

  /* Swiper ラッパー（横はみ出し防止） */
  .fv__swiper-wrap {
    overflow: hidden;
  }

  /* Swiper */
  .fv-swiper {
    width: 85%;
    padding-bottom: 2rem;
  }

  .fv-slide {
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(0,0,0,0.1);
  }

  /* 人物写真 */
  .fv-card__photo {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }

  /* キャッチコピー（通常フロー） */
  .fv__copy {
    background-color: var(--c-g-100);
    padding: 0 2.5rem 1.75rem;
  }

  .fv__title {
    font-size: var(--fs-h3);
    font-weight: 400;
    line-height: 1.5;
    color: var(--c-text);
    letter-spacing: 0.1em;
  }

  /* 端末画像（position で重ねる） */
  .fv__detail {
    position: absolute;
    right: calc((100% - 85%) / 2 + 0.75rem);
    bottom: 0;
    z-index: 10;
    pointer-events: none;
    display: flex;
    align-items: flex-end;
  }

  .fv__detail-device {
    width: clamp(5rem, 17vw, 7.5rem);
    height: auto;
    display: block;
    position: relative;
    z-index: 1;
    margin-right: -2.25rem;
    top: 2rem;
  }

  .fv__detail-img {
    width: clamp(6.5rem, 24vw, 9rem);
    height: auto;
    display: block;
  }

  /* カードのバウンシーアニメーション */
  :global(.fv-swiper .swiper-slide) {
    transition-timing-function: cubic-bezier(0.175, 0.885, 0.32, 1.6) !important;
  }

  /* ページネーション */
  :global(.fv-pagination) {
    bottom: 0.25rem !important;
  }

  :global(.fv-pagination .swiper-pagination-bullet) {
    background-color: var(--c-g-400);
    opacity: 1;
  }

  :global(.fv-pagination .swiper-pagination-bullet-active) {
    background-color: var(--c-green);
  }

  /* 改行の出し分け */
  .br-pc { display: none; }
  .br-sp { display: block; }

  /* PC タイポグラフィ */
  @media (min-width: 1400px) {
    .br-sp { display: none; }
    .br-pc { display: block; }

    .fv__title {
      font-size: 1.75rem;
      font-weight: 400;
      letter-spacing: 0.2em;
    }

    .fv-card__photo {
      aspect-ratio: 640 / 452;
    }
  }

  /* バナー切り替え */
  .fv__banners {
    position: relative;
    background-color: var(--c-g-000);
    padding-top: 4rem;
  }

  .fv__banner {
    display: none;
  }

  .fv__banner.is-active {
    display: block;
  }
</style>

<script>
  import Swiper from 'swiper';
  import { Autoplay, EffectCards } from 'swiper/modules';
  import 'swiper/css';
  import 'swiper/css/effect-cards';

  const swiper = new Swiper('.fv-swiper', {
    modules: [Autoplay, EffectCards],
    effect: 'cards',
    grabCursor: true,
    rewind: true,
    speed: 450,
    autoplay: {
      delay: 3000,
      disableOnInteraction: false,
      pauseOnMouseEnter: true,
    },
    on: {
      slideChange(sw) {
        const banners = document.querySelectorAll('.fv__banner');
        banners.forEach((b, i) => {
          b.classList.toggle('is-active', i === sw.realIndex);
        });
      },
    },
  });
</script>
