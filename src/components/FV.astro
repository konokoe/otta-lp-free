---
import { Image } from 'astro:assets';
import CampaignBanner from './ui/CampaignBanner.astro';
import { en } from '../lib/en';
import mainImg from '../assets/fv-main.png';
import subImg from '../assets/fv-sub.png';
import item01 from '../assets/fv-items-01.png';
import item02 from '../assets/fv-items-02.png';
import item03 from '../assets/fv-items-03.png';

/** 3つの理由カード。iconH はカンプ（375〜390px 幅）での実寸をもとにした clamp */
const reasons = [
  {
    no: 1,
    label: '始めやすい',
    icon: item01,
    iconH: 'clamp(3rem, 12.3vw, 6rem)',
    lines: ['月額0円で', '始められる'],
  },
  {
    no: 2,
    label: '手間いらず',
    icon: item02,
    iconH: 'clamp(3.5rem, 14.4vw, 7rem)',
    lines: ['約6年間、充電不要', '操作もいりません'],
  },
  {
    no: 3,
    label: '緩く見守る',
    icon: item03,
    iconH: 'clamp(3.75rem, 15.6vw, 7.5rem)',
    lines: ['GPSと差別化された', '緩い見守り'],
  },
];
---

<section class="fv">
  <!-- メインビジュアル -->
  <h1 class="fv__visual">
    <Image
      src={mainImg}
      alt="家族の安心を、そっと見守る。高齢者向け見守りサービス 月額0円から始められる"
      class="fv__main"
      format="avif"
      loading="eager"
    />
  </h1>

  <!-- 3つの理由 -->
  <div class="fv__reasons">
    <h2 class="fv__reasons-title" set:html={en('ottaなら続けられる！3つの理由')} />

    <div class="fv__reasons-body">
      <ul class="fv__reason-list">
        {reasons.map(reason => (
          <li class="fv__reason">
            <p class="fv__reason-label">
              <span class="fv__reason-no en">{reason.no}</span>{reason.label}
            </p>
            <div class="fv__reason-icon">
              <Image src={reason.icon} alt="" format="avif" style={`height:${reason.iconH}`} />
            </div>
            <p class="fv__reason-text">
              {reason.lines.map(line => (
                <span class="fv__reason-line" set:html={en(line)} />
              ))}
            </p>
          </li>
        ))}
      </ul>

      <Image src={subImg} alt="" class="fv__town" format="avif" />
    </div>
  </div>

  <!-- キャンペーンバナー -->
  <div class="fv__banner">
    <CampaignBanner location="fv" />
  </div>
</section>

<style>
  .fv {
    /* 固定ヘッダーの逃げ。カンプではメインビジュアル上端が 106px / 390px 幅 */
    padding-top: clamp(6rem, 27.2vw, 7rem);
    background-color: var(--c-cream);
  }

  @media (min-width: 1400px) {
    .fv {
      padding-top: 4rem;
    }
  }

  /* メインビジュアル */
  .fv__visual {
    margin: 0;
  }

  .fv__main {
    width: 100%;
    height: auto;
  }

  /* 3つの理由 */
  .fv__reasons-title {
    margin-top: clamp(0.5rem, 2.6vw, 1.25rem);
    margin-bottom: clamp(0.25rem, 1.5vw, 0.625rem);
    /* カンプ実測 20.5px / 390px 幅。上限は --fs-h2 と同じ 1.75rem */
    font-size: clamp(1.125rem, 5.25vw, 1.75rem);
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: 0.05em;
    text-align: center;
    color: var(--c-text);
  }

  .fv__reasons-body {
    position: relative;
    /* 街並みイラストのうち、カード下端より下に見える分 */
    padding-bottom: 8%;
  }

  /* 街並み（カードの背面に敷く） */
  .fv__town {
    position: absolute;
    left: 0;
    bottom: 0;
    z-index: 0;
    width: 100%;
    height: auto;
  }

  /* カード枠 */
  .fv__reason-list {
    position: relative;
    z-index: 1;
    margin-inline: clamp(0.75rem, 4.1vw, 2rem);
    padding-block: clamp(0.75rem, 3.8vw, 1.5rem);
    display: flex;
    align-items: stretch;
    border: 1px solid var(--c-green);
    border-radius: 0.5rem;
  }

  .fv__reason {
    /* ラベル・説明文の文字サイズ。カンプ（390px 幅）の 12px を基準に、
       狭い端末でも「約6年間、充電不要」が1行に収まるよう幅追従させる */
    --reason-fs: clamp(0.5rem, 2.8vw, 0.875rem);

    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    /* コンテナは --max-w で頭打ちになるため、vw の余白も上限を設ける。
       これがないと超広幅でラベルが折り返す */
    padding-inline: min(1.5vw, 0.75rem);
  }

  /* 列の区切り（点線） */
  .fv__reason + .fv__reason {
    position: relative;
  }

  .fv__reason + .fv__reason::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.25rem;
    bottom: 0.5rem;
    border-left: 1px dotted var(--c-green);
  }

  /* ①始めやすい */
  .fv__reason-label {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
    font-size: var(--reason-fs);
    line-height: 1.4;
    color: var(--c-dark);
  }

  .fv__reason-no {
    flex-shrink: 0;
    width: 1.75em;
    height: 1.75em;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--c-dark);
    color: var(--c-g-000);
    font-weight: 700;
    border-radius: 50%;
  }

  /* アイコン（3列で高さを揃え、上下中央に置く） */
  .fv__reason-icon {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: clamp(0.5rem, 4vw, 1.25rem);
    padding-bottom: clamp(0.25rem, 1.8vw, 0.75rem);
  }

  .fv__reason-icon :global(img) {
    width: auto;
    max-width: 100%;
    object-fit: contain;
  }

  /* 説明文 */
  .fv__reason-text {
    font-size: var(--reason-fs);
    line-height: 1.3;
    letter-spacing: 0.02em;
    text-align: center;
    color: var(--c-dark);
  }

  /* 改行位置はカンプ通りに固定する */
  .fv__reason-line {
    display: block;
    white-space: nowrap;
  }

  /* キャンペーンバナー */
  .fv__banner {
    position: relative;
    background-color: var(--c-g-000);
    padding-top: clamp(1.5rem, 10.3vw, 5rem);
  }

  @media (min-width: 1400px) {
    .fv__reason {
      --reason-fs: var(--fs-s);
    }
  }
</style>
