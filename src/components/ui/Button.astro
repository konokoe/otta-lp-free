---
interface Props {
  href?: string;
  variant?: 'primary' | 'outline';
  size?: 'md' | 'lg';
  fullWidth?: boolean;
  note?: string;
}

const {
  href = '#',
  variant = 'primary',
  size = 'lg',
  fullWidth = false,
  note,
} = Astro.props;
---

<div class:list={['btn-wrap', fullWidth && 'btn-wrap--full']}>
  <a
    href={href}
    class:list={['btn', `btn--${variant}`, `btn--${size}`]}
  >
    <slot />
    <span class="btn__arrow">›</span>
  </a>
  {note && <p class="btn__note">{note}</p>}
</div>

<style>
  .btn-wrap {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }
  .btn-wrap--full {
    display: flex;
    width: 100%;
  }
  .btn-wrap--full .btn {
    width: 100%;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    border-radius: 9999px;
    transition: opacity 0.2s;
  }
  .btn:hover {
    opacity: 0.85;
  }

  /* size */
  .btn--md {
    font-size: var(--fs-s);
    padding: 0.625rem clamp(1.25rem, 5%, 1.75rem);
  }
  .btn--lg {
    font-size: var(--fs-m);
    padding: clamp(0.75rem, 2.5vw, 1rem) clamp(1.5rem, 6%, 2rem);
  }

  /* variant */
  .btn--primary {
    background-color: var(--c-red);
    color: var(--c-g-000);
  }
  .btn--outline {
    background-color: transparent;
    color: var(--c-red);
    border: 2px solid var(--c-red);
  }

  .btn__arrow {
    font-size: 1.25em;
    line-height: 1;
  }

  .btn__note {
    font-size: var(--fs-xs);
    color: var(--c-text-muted);
    text-align: center;
  }
</style>
