---
import { Image } from 'astro:assets';
import logoSrc from '../assets/logo.svg';
import ArrowIcon from './icon/ArrowIcon.astro';
import { SHOP_URL, AMAZON_URL } from '../lib/links';
import { en } from '../lib/en';

const navItems = [
  { label: '無料プランと有料プランの違い', href: '#plan-diff' },
  { label: 'otta.aの3つのポイント',       href: '#points' },
  { label: '見守りネットワーク',          href: '#network' },
  { label: 'サービス利用の流れ',          href: '#flow' },
  { label: '料金プラン',                  href: '#pricing' },
  { label: 'GPSとの違い',                 href: '#product' },
  { label: 'メディア掲載情報',            href: '#voices' },
  { label: 'よくある質問',               href: '#faq' },
];
---

<div class="menu-overlay" id="header-menu" aria-hidden="true" role="dialog" aria-modal="true" aria-label="メニュー">
  <div class="menu">
    <!-- ヘッダー行 -->
    <div class="menu__header">
      <div class="menu__logo-wrap">
        <Image src={logoSrc} alt="otta" class="menu__logo-img" />
      </div>
      <button type="button" class="menu__close" id="menu-close" aria-label="メニューを閉じる">
        <span class="menu__close-icon">✕</span>
        <span class="menu__close-label">close</span>
      </button>
    </div>

    <!-- 購入CTAカード -->
    <a href={SHOP_URL} class="menu__cta-card js-cta" data-cta-shop="official" data-cta-location="menu" target="_blank" rel="noopener noreferrer">
      <span class="menu__cta-text">公式ショップで購入</span>
      <span class="menu__cta-arrow"><ArrowIcon fill="#BF4D4D" size={7} /></span>
    </a>

    <a href={AMAZON_URL} class="menu__cta-card menu__cta-card--amazon js-cta" data-cta-shop="amazon" data-cta-location="menu" target="_blank" rel="noopener noreferrer">
      <span class="menu__cta-text"><span class="en">Amazon</span>で購入</span>
      <span class="menu__cta-arrow"><ArrowIcon fill="#2C4C75" size={7} /></span>
    </a>

    <!-- ナビ -->
    <nav class="menu__nav">
      {navItems.map(item => (
        <a
          href={item.href}
          class="menu__nav-item js-nav"
          data-nav-label={item.label}
          data-nav-target={item.href}
          data-nav-location="sp-menu"
        >
          <span set:html={en(item.label)}></span>
          <ArrowIcon fill="rgba(255,255,255,0.6)" size={5} rotate={90} />
        </a>
      ))}
    </nav>
  </div>
</div>

<style>
  .menu-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s, visibility 0.25s;
    /* body の max-width に合わせて中央配置 */
    max-width: var(--max-w);
    margin-inline: auto;
    overflow: hidden;
  }

  .menu-overlay.is-open {
    opacity: 1;
    visibility: visible;
  }

  .menu {
    width: 100%;
    height: 100%;
    background-color: var(--c-green);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
  }

  /* ヘッダー行 */
  .menu__header {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: clamp(1.5rem, 6vw, 2rem) var(--px) clamp(1.5rem, 6vw, 2rem);
  }

  .menu__logo-wrap {
    grid-column: 2;
    display: flex;
    align-items: center;
  }

  .menu__logo-img {
    height: clamp(2.5rem, 8vw, 3rem);
    width: auto;
    filter: brightness(0) invert(1);
  }

  .menu__close {
    grid-column: 3;
    justify-self: end;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    width: clamp(3rem, 11vw, 3.5rem);
    height: clamp(3rem, 11vw, 3.5rem);
    border-radius: 9999px;
    background-color: var(--c-g-000);
    border: none;
    cursor: pointer;
  }

  .menu__close-icon {
    font-size: var(--fs-s);
    color: var(--c-text);
    line-height: 1;
  }

  .menu__close-label {
    font-size: 0.5rem;
    color: var(--c-text);
    letter-spacing: normal;
  }

  /* 購入CTAカード */
  .menu__cta-card {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    margin: 0 var(--px) 0.5rem;
    background-color: var(--c-g-000);
    border: 0.1875rem solid var(--c-red);
    border-radius: 0.5rem;
    padding: 0.875rem 0.75rem;
    transition: background-color 0.2s, color 0.2s;
  }

  .menu__cta-arrow {
    position: absolute;
    right: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
  }

  .menu__cta-text {
    font-size: var(--fs-m);
    font-weight: 700;
    color: var(--c-red);
  }

  .menu__cta-card--amazon {
    border-color: var(--c-dark);
  }

  .menu__cta-card--amazon .menu__cta-text {
    color: var(--c-dark);
  }

  @media (hover: hover) and (pointer: fine) {
    .menu__cta-card:hover {
      background-color: var(--c-red);
    }

    .menu__cta-card--amazon:hover {
      background-color: var(--c-dark);
    }
    .menu__cta-card:hover .menu__cta-text {
      color: var(--c-g-000);
    }
    .menu__cta-card:hover :global(svg path) {
      fill: var(--c-g-000);
    }
  }

  /* ナビ */
  .menu__nav {
    display: flex;
    flex-direction: column;
  }

  .menu__nav-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: clamp(0.875rem, 3vw, 1rem) var(--px);
    font-size: var(--fs-m);
    font-weight: 400;
    color: var(--c-g-000);
    border-bottom: 1px solid rgba(255,255,255,0.25);
    transition: background-color 0.2s, padding-left 0.2s;
  }

  @media (hover: hover) and (pointer: fine) {
    .menu__nav-item:hover {
      background-color: rgba(255,255,255,0.1);
      padding-left: calc(var(--px) + 0.5rem);
    }
  }
</style>

<script>
  const overlay = document.getElementById('header-menu') as HTMLElement | null;
  const closeBtn = document.getElementById('menu-close');

  function getFocusables(container: HTMLElement): HTMLElement[] {
    return Array.from(
      container.querySelectorAll<HTMLElement>(
        'button:not([disabled]), [href], [tabindex]:not([tabindex="-1"])'
      )
    );
  }

  function closeMenu() {
    overlay?.classList.remove('is-open');
    overlay?.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    const openBtn = document.getElementById('menu-open');
    openBtn?.setAttribute('aria-expanded', 'false');
    (openBtn as HTMLElement | null)?.focus();
  }

  closeBtn?.addEventListener('click', closeMenu);

  overlay?.querySelectorAll('.menu__nav-item').forEach(link => {
    link.addEventListener('click', closeMenu);
  });

  overlay?.addEventListener('keydown', e => {
    if (e.key === 'Escape') { closeMenu(); return; }
    if (e.key === 'Tab' && overlay) {
      const focusables = getFocusables(overlay);
      if (!focusables.length) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault(); last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault(); first.focus();
      }
    }
  });
</script>
