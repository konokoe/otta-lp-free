---
import { Image } from 'astro:assets';
import Heading from './ui/Heading.astro';
import mediaBg from '../assets/section08-bg.png';
import tvIcon from '../assets/icon/tv.svg';
import newspaperIcon from '../assets/icon/newspaper.svg';
import { en } from '../lib/en';

const media = {
  tv: [
    'NHK おはよう日本 まちかど情報室',
    'テレビ東京【ガイアの夜明け】',
    'TBS「THE TIME,」',
    'TBS「ひるおび」',
  ],
  newspaper: ['朝日新聞'],
};
---

<section class="voices" id="voices" style={`--voices-bg: url(${mediaBg.src})`}>

  <!-- メディア掲載 -->
  <div class="media">
    <div class="media__heading">
      <Heading title="メディア掲載" sub="MEDIA" />
    </div>

    <div class="media__inner">
      <div class="media__group">
        <p class="media__category">
          <Image src={tvIcon} alt="" class="media__icon" />テレビ
        </p>
        <ul class="media__list">
          {media.tv.map(item => (
            <li class="media__item" set:html={en(item)}></li>
          ))}
        </ul>
      </div>

      <div class="media__group">
        <p class="media__category">
          <Image src={newspaperIcon} alt="" class="media__icon" />新聞
        </p>
        <ul class="media__list">
          {media.newspaper.map(item => (
            <li class="media__item">{item}</li>
          ))}
        </ul>
      </div>

      <p class="media__note">※弊社の製品・サービスが紹介されました</p>
    </div>
  </div>

</section>

<style>
  .voices {
    background-color: #EDF4F1;
    background-image: var(--voices-bg);
    background-size: cover;
    background-position: bottom;
    padding-top: var(--section-pt);
    padding-bottom: var(--section-pt);
    display: flex;
    flex-direction: column;
    gap: var(--section-pt);
  }

  /* メディア掲載 */
  .media__heading {
    padding-inline: var(--section-px);
    margin-bottom: var(--content-gap);
  }

  .media__inner {
    margin-inline: var(--section-px);
    background-color: var(--c-g-000);
    border-radius: 0.75rem;
    padding: 1.25rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
  }

  @media (min-width: 769px) {
    .media__inner {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }
  }

  .media__group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .media__category {
    font-size: var(--fs-h3);
    font-weight: 700;
    color: var(--c-text);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .media__icon {
    width: 1.5em;
    height: auto;
    display: inline-block;
  }

  .media__list {
    display: flex;
    flex-direction: column;
  }

  .media__item {
    font-size: var(--fs-m);
    color: var(--c-text);
    padding-block: 0.5rem;
    border-bottom: 1px solid var(--c-red);
    list-style: none;
  }

  .media__note {
    font-size: var(--fs-xs);
    color: var(--c-text-muted);
  }
</style>
