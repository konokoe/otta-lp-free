---
// Features section
---

<section class="features py-20 bg-white">
  <div class="max-w-4xl mx-auto px-4 text-center">
    <h2 class="text-2xl font-bold text-slate-800 mb-4">特徴</h2>
    <p class="text-slate-400 text-sm">［Features セクション 仮コンテンツ］</p>
    <div class="grid grid-cols-3 gap-6 mt-10">
      {[1, 2, 3].map((n) => (
        <div class="bg-slate-50 rounded-xl p-6">
          <div class="w-10 h-10 bg-slate-200 rounded-full mx-auto mb-3" />
          <p class="text-sm text-slate-500">特徴 {n}</p>
        </div>
      ))}
    </div>
  </div>
</section>
