---
import HeaderMenu from './HeaderMenu.astro';
import { Image } from 'astro:assets';
import logoSrc from '../assets/logo.svg';
---

<header class="header">
  <div class="header__inner">
    <div class="header__logo-wrap">
      <Image src={logoSrc} alt="otta" class="header__logo-img" />
    </div>

    <button type="button" class="header__menu-btn" id="menu-open" aria-label="メニューを開く" aria-controls="header-menu" aria-expanded="false">
      <span class="header__menu-lines">
        <span></span>
        <span></span>
        <span></span>
      </span>
      <span class="header__menu-label">menu</span>
    </button>
  </div>
</header>

<HeaderMenu />

<style>
  .header {
    position: fixed;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    max-width: var(--max-w);
    z-index: 50;
    pointer-events: none;
  }

  @media (min-width: 1400px) {
    .header {
      display: none;
    }
  }

  .header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: clamp(1.5rem, 6vw, 2rem) var(--px);
    pointer-events: auto;
    background-color: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    transition: background-color 0.3s, backdrop-filter 0.3s;
  }

  .header__inner.is-scrolled {
    background-color: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  /* ロゴ */
  .header__logo-wrap {
    grid-column: 2;
    display: flex;
    align-items: center;
  }

  .header__logo-img {
    height: clamp(2.5rem, 8vw, 3rem);
    width: auto;
    filter: none;
  }

  /* メニューボタン */
  .header__menu-btn {
    grid-column: 3;
    justify-self: end;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    width: clamp(3rem, 11vw, 3.5rem);
    height: clamp(3rem, 11vw, 3.5rem);
    border-radius: 9999px;
    background-color: var(--c-g-000);
    border: none;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(0,0,0,0.15);
    transition: opacity 0.2s;
  }

  .header__menu-btn:hover { opacity: 0.85; }

  .header__menu-lines {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .header__menu-lines span {
    display: block;
    width: 1.1rem;
    height: 1.5px;
    background-color: var(--c-text);
    border-radius: 1px;
  }

  .header__menu-label {
    font-size: 0.5rem;
    letter-spacing: normal;
    color: var(--c-text);
    line-height: 1;
  }
</style>

<script>
  const inner = document.querySelector<HTMLElement>('.header__inner');
  window.addEventListener('scroll', () => {
    inner?.classList.toggle('is-scrolled', window.scrollY > 0);
  }, { passive: true });

  const openBtn = document.getElementById('menu-open');
  const overlay = document.getElementById('header-menu');

  openBtn?.addEventListener('click', () => {
    overlay?.classList.add('is-open');
    overlay?.setAttribute('aria-hidden', 'false');
    openBtn.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    const first = overlay?.querySelector<HTMLElement>(
      'button:not([disabled]), [href], [tabindex]:not([tabindex="-1"])'
    );
    first?.focus();
  });
</script>
