---
import { Image } from 'astro:assets';
import Heading from './ui/Heading.astro';
import ArrowIcon from './icon/ArrowIcon.astro';
import PhoneIcon from './icon/PhoneIcon.astro';
import mapImg from '../assets/section011-item-02.png';
import { en } from '../lib/en';

const faqs = [
  {
    q: '月額0円のサービスに利用期限はありますか？',
    a: '利用期限はありません。月額0円で継続してご利用いただけます。',
  },
  {
    q: 'なぜ"GPS"ではなく、"otta BLE"を使う人が多いのですか？',
    a: '見守りに必要なのは、現在地だけでなく" いつも通りの行動かどうか。\notta BLE は、どこを通り、いつ到着したかを時系列で把握できるので、生活導線や生活リズムをやさしく見守りすることができます。見守りの用途では「精度より継続性・電池寿命・つけやすさ」が重要です。\n※BLE（Bluetooth Low Energy）は近距離での信号を検知する方式で、屋内・商業施設・病院など GPS が苦手な場所でも位置が掴みやすいのが特徴です。',
  },
  {
    q: '電池の持ちはどれくらいですか？',
    a: '高齢者の方は充電を忘れてしまうケースが多いため、「付けっぱなしにできる」otta BLE の電池持ちは大きなメリットです。長期的なご利用の場合も低コストで導入できて、経済的な負担も少ないことからotta BLE が導入されやすい傾向があります。\n・otta BLE：数年～最長約6年（電池交換不要）\n・GPS：数日～数週間（頻繁な充電が必要）',
  },
  {
    q: 'ひとり歩きの高齢者の見守りに使えますか？',
    a: 'はい。万が一の行動にもご利用いただけます。\n高齢者の方は、otta の見守り端末を持つだけでOK（スマホ不要）。お守り型の端末なので、日常使いできる小物として財布やバッグの内ポケット、杖や車いすなど、肌身離さず持ち歩ける場所に装着することができます。\n見守るご家族側はスマホアプリでシンプルに確認できます。',
  },
  {
    q: '自分の住んでいるところに見守りスポットはありますか？',
    a: '下のボタンから見守りスポットの場所を確認することができます。',
    hasMap: true,
    cta: '見守りスポットを確認する',
    ctaHref: 'https://www.otta.me/map/detail/',
  },
];
---

<section class="faq" id="faq">
  <div class="faq__inner">
    <Heading title="よくある質問" sub="Q&A" />

    <div class="faq__list">
      {faqs.map((item, i) => (
        <details class="faq__item">
          <summary class="faq__question">
            <span class="faq__q-icon en">Q</span>
            <span class="faq__q-text" set:html={en(item.q)}></span>
            <span class="faq__toggle">+</span>
          </summary>
          <div class="faq__answer">
            <div class="faq__answer-inner">
              {item.a && (
                <p class="faq__a-text">
                  {item.a.split('\n').map((line, j) => (
                    <span><Fragment set:html={en(line)} />{j < item.a!.split('\n').length - 1 && <br />}</span>
                  ))}
                </p>
              )}
{item.hasMap && <Image src={mapImg} alt="" class="faq__map-img" format="avif" />}
              {item.cta && (
                <a href={item.ctaHref ?? '#'} class="faq__cta" target="_blank" rel="noopener noreferrer"
                   aria-label={`${item.cta}（新しいタブで開きます）`}>
                  {item.cta}
                  <ArrowIcon fill="#FFFFFF" size={6} />
                </a>
              )}
              {item.phone && (
                <>
                  <a href={`tel:${item.phone}`} class="faq__phone-btn">
                    <PhoneIcon fill="#FFFFFF" size={16} />
                    <span class="en">{item.phone}</span>
                  </a>
                  <p class="faq__phone-text faq__phone-text--sp" set:html={en(item.phoneTextSp ?? '')}></p>
                  <p class="faq__phone-text faq__phone-text--pc" set:html={en(item.phoneTextPc ?? '')}></p>
                </>
              )}
            </div>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    background-color: var(--c-g-000);
    padding-top: var(--section-pt);
    padding-bottom: var(--section-pt);
  }

  .faq__inner {
    padding-inline: var(--section-px);
    display: flex;
    flex-direction: column;
    gap: var(--content-gap);
  }

  .faq__list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  /* アコーディオン */
  .faq__item {
    background-color: var(--c-g-100);
    border-radius: 0.5rem;
    overflow: hidden;
  }

  .faq__question {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem;
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition: background-color 0.2s;
  }

  @media (hover: hover) and (pointer: fine) {
    .faq__question:hover {
      background-color: var(--c-g-200);
    }
  }

  .faq__question::-webkit-details-marker { display: none; }

  .faq__q-icon {
    flex-shrink: 0;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background-color: var(--c-blue);
    color: var(--c-g-000);
    font-size: var(--fs-m);
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .faq__q-text {
    flex: 1;
    font-size: var(--fs-m);
    font-weight: 700;
    color: var(--c-text);
    line-height: 1.5;
  }

  .faq__toggle {
    flex-shrink: 0;
    font-size: var(--fs-m);
    color: var(--c-text-muted);
    transition: transform 0.25s;
  }

  @media (min-width: 769px) {
    .faq__toggle {
      font-size: var(--fs-h2);
    }
  }

  .faq__item[open] .faq__toggle {
    transform: rotate(45deg);
  }

  /* 回答エリア */
  .faq__answer {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s ease;
  }

  .faq__item[open] .faq__answer {
    grid-template-rows: 1fr;
  }

  .faq__answer-inner {
    overflow: hidden;
    padding: 0 1rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .faq__a-text {
    font-size: var(--fs-m);
    color: var(--c-text);
    line-height: 1.75;
  }

  .faq__item-img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 0.5rem;
  }

  .faq__map-img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 0.5rem;
  }

  .faq__cta {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    background-color: var(--c-green);
    color: var(--c-g-000);
    font-size: var(--fs-m);
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 0.75rem 1rem;
    border-radius: 9999px;
    border: 2px solid var(--c-green);
    transition: background-color 0.2s, color 0.2s, transform 0.2s, box-shadow 0.2s;
  }

  .faq__cta :global(svg path) {
    transition: fill 0.2s;
  }

  .faq__cta :global(svg) {
    position: absolute;
    right: 1.25rem;
    top: 50%;
    transform: translateY(-50%);
    transition: transform 0.2s;
  }

  @media (hover: hover) and (pointer: fine) {
    .faq__cta:hover {
      background-color: var(--c-g-000);
      color: var(--c-green);
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(128, 182, 160, 0.4);
    }

    .faq__cta:hover :global(svg path) {
      fill: var(--c-green);
    }

    .faq__cta:hover :global(svg) {
      transform: translateY(-50%) translateX(3px);
    }
  }

  .faq__phone-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background-color: var(--c-blue);
    color: var(--c-g-000);
    font-size: var(--fs-m);
    font-weight: 700;
    padding: 0.75rem 1rem;
    border-radius: 9999px;
    border: 2px solid var(--c-blue);
  }

  .faq__phone-text {
    font-size: var(--fs-m);
    color: var(--c-text);
    line-height: 1.75;
  }

  .faq__phone-text--pc {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .faq__phone-btn {
      display: none;
    }

    .faq__phone-text--sp {
      display: none;
    }

    .faq__phone-text--pc {
      display: block;
    }
  }
</style>

<script>
  const allItems = Array.from(document.querySelectorAll<HTMLDetailsElement>('.faq__item'));

  function closeItem(details: HTMLDetailsElement) {
    const answer = details.querySelector<HTMLElement>('.faq__answer')!;
    answer.style.gridTemplateRows = '0fr';
    answer.addEventListener('transitionend', (e) => {
      if ((e as TransitionEvent).propertyName !== 'grid-template-rows') return;
      details.removeAttribute('open');
    }, { once: true });
  }

  allItems.forEach(details => {
    const summary = details.querySelector('summary')!;
    const answer = details.querySelector<HTMLElement>('.faq__answer')!;

    summary.addEventListener('click', e => {
      e.preventDefault();

      if (details.open) {
        closeItem(details);
      } else {
        answer.style.gridTemplateRows = '0fr';
        details.setAttribute('open', '');
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            answer.style.gridTemplateRows = '1fr';
          });
        });
      }
    });
  });
</script>
